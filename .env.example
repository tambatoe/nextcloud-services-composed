# =============================================================================
# Template delle variabili d'ambiente per Infrastruttura Docker Standalone.
# Copia questo file in ".env" e personalizza i valori prima dell'avvio.
# Il file ".env" NON va mai committato su git.
# =============================================================================

# --- Dominio e Rete VPN ---
VPN_DOMAIN=vpn.local
VPN_SERVER_IP=10.8.0.1
VPN_SUBNET=10.8.0.0
VPN_NETMASK=255.255.255.0
OPENVPN_PORT=1194
SERVER_PUBLIC_IP=127.0.0.1

# --- Domini dei Servizi (risolti tramite Caddy e dnsmasq) ---
NEXTCLOUD_DOMAIN=nextcloud.vpn.local
VAULTWARDEN_DOMAIN=vault.vpn.local

# --- Porte locali esposte per Caddy Reverse Proxy ---
NEXTCLOUD_PORT=8080
VAULTWARDEN_PORT=8081

# --- MariaDB / Database Nextcloud ---
MYSQL_ROOT_PASSWORD=cambiami_password_root_sicura
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=cambiami_password_utente_sicura

# --- Nextcloud ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=cambiami_password_admin_sicura
PATH_NEXTCLOUD_DATA=./nextcloud_data
PATH_GDRIVE_SYNC=./gdrive_sync

# --- Vaultwarden ---
# Abilita la registrazione del primo account admin/utente.
# Dopo aver creato l'account, imposta SIGNUPS_ALLOWED=false per bloccare nuove registrazioni.
SIGNUPS_ALLOWED=true
# Token per accedere al pannello /admin di Vaultwarden (es. openssl rand -base64 32 o hash argon2)
VAULTWARDEN_ADMIN_TOKEN=cambiami_token_admin_lungo_e_casuale
PATH_VAULTWARDEN_DATA=./vaultwarden_data

# --- Percorsi Volumi Host (Default relativi al repository) ---
PATH_DNSMASQ_CONF=./dnsmasq_conf
PATH_OPENVPN_KEYS=./openvpn_keys
PATH_BACKUPS=./backups

# --- Backup & Google Drive (infra-tools) ---
BACKUP_RETENTION_DAYS=14
# Imposta a true solo se hai posizionato un file rclone.conf valido in ./rclone/rclone.conf
BACKUP_UPLOAD_TO_DRIVE=false
# Passphrase opzionale per cifrare con GPG gli archivi di backup. Se vuota, non cifra.
BACKUP_GPG_PASSPHRASE=
RCLONE_REMOTE=gdrive
RCLONE_REMOTE_FOLDER=
RCLONE_BACKUP_PATH=infra-backups
